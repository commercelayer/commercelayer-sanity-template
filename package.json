{
  "name": "sanity-template-commercelayer",
  "version": "1.4.0",
  "description": "A multi-country ecommerce template built with Commerce Layer, Next.js, Sanity studio, and deployed to Netlify.",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "next",
    "build": "next build",
    "start": "next start",
    "format": "pnpx prettier --write . --ignore-path .gitignore",
    "check": "next lint --ignore-path .gitignore",
    "check:fix": "pnpm run format && next lint --fix --ignore-path .gitignore",
    "export": "sanity dataset export production ./data/production.tar.gz",
    "clean": "pnpx rimraf --glob **/node_modules **/pnpm-lock.yaml",
    "dep:major": "pnpm dlx npm-check-updates --packageFile '**/package.json' -u && node replace-react.mjs",
    "dep:semver": "pnpm dlx npm-check-updates --packageFile '**/package.json' -u -t semver && node replace-react.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/commercelayer/commercelayer-sanity-template.git"
  },
  "author": {
    "name": "Commerce Layer",
    "email": "development@commercelayer.io"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/commercelayer/commercelayer-sanity-template/issues"
  },
  "homepage": "https://github.com/commercelayer/commercelayer-sanity-template#readme",
  "keywords": [
    "commercelayer",
    "sanity",
    "reactjs",
    "nextjs",
    "jamstack",
    "headless",
    "ecommerce",
    "api"
  ],
  "dependencies": {
    "@commercelayer/js-auth": "^6.7.2",
    "@commercelayer/react-components": "4.9.0",
    "@headlessui/react": "^1.7.19",
    "@next/env": "^14.2.35",
    "@portabletext/react": "^3.2.4",
    "@sanity/client": "^6.29.1",
    "@sanity/image-url": "^1.2.0",
    "@sanity/vision": "^3.99.0",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.4.1",
    "@tailwindcss/typography": "^0.5.20",
    "@typescript-eslint/typescript-estree": "^7.18.0",
    "autoprefixer": "10.4.5",
    "axios": "^1.20.0",
    "iframe-resizer-react": "^1.1.1",
    "js-cookie": "^3.0.8",
    "next": "^14.2.35",
    "next-sanity": "^8.5.5",
    "postcss": "^8.5.28",
    "prop-types": "^15.8.1",
    "query-string": "^7.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0",
    "sanity": "^3.99.0",
    "semver": "^7.8.5",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^13.5.11",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash": "^4.17.25",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "eslint": "^8.57.1",
    "eslint-config-next": "^13.5.11",
    "eslint-config-prettier": "^8.10.2",
    "globby": "^13.2.2",
    "postcss-flexbugs-fixes": "5.0.2",
    "postcss-preset-env": "^7.8.3",
    "prettier": "^2.8.8",
    "tailwindcss": "^3.4.19",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  }
}
